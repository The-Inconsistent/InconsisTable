DATABASE_URL=postgres://it:it@localhost:5435/it
# 32+ characters or the api refuses to boot ("change-me" too). Generate: openssl rand -hex 32
ADMIN_KEY=
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PORT=4000

# Clerk (Dashboard → API keys). CLERK_JWT_KEY is the PEM public key, for verifying sessions without a network call.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Dev/test only: lets the smoke test act as signed-in users. Never set in production (the api refuses to start).
CLERK_TEST_SECRET=

# Trust the CF-Connecting-IP header for rate limits. Set to 1 only behind Cloudflare; any client can forge it otherwise.
TRUST_CF=

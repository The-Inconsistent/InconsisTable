DATABASE_URL=postgres://it:it@localhost:5435/it
# Optional: leave empty to turn the admin page and the admin-key scripts off. If set, 32+ characters or the api refuses
# to boot ("change-me" too). Generate: openssl rand -hex 32
ADMIN_KEY=
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Trust the CF-Connecting-IP header for rate limits. Set to 1 only behind Cloudflare; any client can forge it otherwise.
TRUST_CF=

# Sign-in through a local InconsisID (docs/deploy.md, Sign-in). Leave IDP_SIGN_IN empty to stay anonymous.
IDP_SIGN_IN=
IDP_DEV_HTTP=1
IDP_ISSUER=http://localhost:4100
IDP_CLIENT_ID=inconsistable-dev
IDP_REDIRECT_URI=http://localhost:3000/api/auth/callback
IDP_CLIENT_JWK_FILE=../../../InconsisID/.secrets/inconsistable_dev_client_jwk.json

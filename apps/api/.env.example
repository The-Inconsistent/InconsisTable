DATABASE_URL=postgres://it:it@localhost:5435/it
# Optional: leave empty to turn the admin-key path off. If set, 32+ characters or the api refuses to boot ("change-me"
# too). Generate: openssl rand -hex 32
ADMIN_KEY=
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Clerk (Dashboard → API keys). CLERK_JWT_KEY is the PEM public key, for verifying sessions without a network call.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Signing secret (whsec_...) of the Clerk webhook to /api/webhooks/clerk (events user.updated, user.deleted), which drops
# the open sockets of a user whose role or lock changed. Empty: the endpoint answers 503.
CLERK_WEBHOOK_SECRET=
# Dev/test only: lets the smoke test act as signed-in users. Never set in production (the api refuses to start).
CLERK_TEST_SECRET=

# Trust the CF-Connecting-IP header for rate limits. Set to 1 only behind Cloudflare; any client can forge it otherwise.
TRUST_CF=

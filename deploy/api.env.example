# Copy to deploy/api.env (never committed). See docs/deploy.md for every rule.
DATABASE_URL=postgres://it:change-me-long-random@postgres:5432/it
ADMIN_KEY=change-me-long-random
# The real public origin of the web, with scheme and no trailing slash.
WEB_ORIGIN=https://table.example.com
COOKIE_SECURE=true
PORT=4000
CLERK_SECRET_KEY=sk_live_...
# The PEM public key (Clerk Dashboard, API keys, "JWT public key"); keep the newlines or write them as \n.
CLERK_JWT_KEY=
# Only behind Cloudflare. Leave empty otherwise.
TRUST_CF=
# Never set CLERK_TEST_SECRET in production: the api refuses to start.

# Copy to deploy/api.env (never committed). See docs/deploy.md for every rule.
DATABASE_URL=postgres://it:change-me-long-random@postgres:5432/it
# Optional (empty turns the admin page off). If set, 32+ characters or the api refuses to boot. Generate: openssl rand -hex 32
ADMIN_KEY=
# The address the web is opened at, with scheme and no trailing slash (the table's LAN address, comma separated for several).
WEB_ORIGIN=http://192.168.1.10:3000
PORT=4000
# Only behind Cloudflare. Leave empty otherwise.
TRUST_CF=
# Sign-in through InconsisID (docs/deploy.md, Sign-in). Leave IDP_SIGN_IN empty to keep every browser anonymous.
IDP_SIGN_IN=
IDP_ISSUER=https://auth.example.com
IDP_CLIENT_ID=inconsistable
IDP_REDIRECT_URI=https://table.example.com/api/auth/callback
# The client's private ES256 JWK, mounted as a secret file.
IDP_CLIENT_JWK_FILE=/run/secrets/idp_client_jwk.json
